# Copy to .env and adjust. Used by docker compose and by `pnpm dev`.

# ---- Database: "sqlite" (default) or "mysql" --------------------------------
DB_DRIVER=sqlite
# With MySQL under docker compose, also enable the mysql service:
# COMPOSE_PROFILES=mysql

# SQLite file (defaults to $DATA_DIR/gantry.db)
# SQLITE_PATH=./data/gantry.db

# MySQL (either DATABASE_URL or the separate fields)
# DATABASE_URL=mysql://gantry:gantry@127.0.0.1:3306/gantry
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=gantry
MYSQL_USER=gantry
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ---- Gantry -----------------------------------------------------------------
# Signs session cookies (>= 32 chars). Leave empty to auto-generate
# $DATA_DIR/secret.key. Generate one with: openssl rand -base64 48
GANTRY_SECRET=
# Where SQLite and the generated secret live (/data in the container)
# DATA_DIR=./data
# true | false | auto (Secure when the request arrived over HTTPS)
COOKIE_SECURE=auto
SESSION_TTL_HOURS=12
# true only behind a reverse proxy you control that sets X-Forwarded-For
# (enables per-client login rate limits; never trust it otherwise)
TRUST_PROXY=false
# First run: /setup asks for a one-time token printed in the server log and
# stored in $DATA_DIR/setup-token. Set your own (>= 16 chars) if you prefer:
# GANTRY_SETUP_TOKEN=
# ...or skip /setup and create the first admin at startup:
# GANTRY_ADMIN_USERNAME=admin
# GANTRY_ADMIN_PASSWORD=
# Docker socket for the default "local" environment
# DOCKER_SOCKET=/var/run/docker.sock
# Resource usage history for the dashboard chart: how often every environment
# is sampled (seconds, minimum 10) and how long samples are kept (days)
METRICS_INTERVAL_SECONDS=60
METRICS_RETENTION_DAYS=7
# How often the registries are asked whether containers' image tags have a
# newer version (hours; 0 = only when "Check updates" is clicked)
UPDATE_CHECK_INTERVAL_HOURS=6
# Scheduled backups go to $DATA_DIR/backups unless set (mount another disk)
# BACKUP_DIR=/backups
# Vulnerability scans run this Trivy image on the environment holding the
# image; its database is cached in a named volume there. Mirrors and offline
# use: TRIVY_DB_REPOSITORY, TRIVY_JAVA_DB_REPOSITORY, TRIVY_SKIP_DB_UPDATE,
# TRIVY_SKIP_JAVA_DB_UPDATE, TRIVY_OFFLINE_SCAN and TRIVY_INSECURE are passed
# on to the scanner (see the README)
# TRIVY_IMAGE=aquasec/trivy:0.76.1
# TRIVY_CACHE_VOLUME=gantry-trivy-cache
# TRIVY_TIMEOUT_MINUTES=20
# File browser (containers and volumes): largest upload (MB) and largest
# text file the editor opens/saves (KB)
FILES_UPLOAD_MAX_MB=512
FILES_EDIT_MAX_KB=1024
# Entries shown per folder; listing a stopped/shell-less container reads
# Docker's tar archive of the folder and stops after this many MB or seconds
# FILES_LIST_MAX_ENTRIES=5000
# FILES_SCAN_MAX_MB=512
# FILES_SCAN_TIMEOUT_SECONDS=30
# Volumes are opened by short-lived helper containers from this image (needs
# sh, stat and rm; pulled when missing), kept this long for reuse when idle
# FILES_HELPER_IMAGE=alpine:3
# FILES_HELPER_IDLE_SECONDS=120
# Helm (Kubernetes chart installs/upgrades): the helm 3 CLI, else `helm` on the
# PATH (the Docker image includes one). Its config, cache and data live in
# $DATA_DIR/helm/. At most HELM_MAX_OPERATIONS helm operations run at once;
# each is killed 2 minutes after its own --timeout (1-30 minutes).
# HELM_BIN=/usr/local/bin/helm
# HELM_MAX_OPERATIONS=4
# Tests only: accept http:// Git repository URLs on loopback hosts (the E2E
# suite serves one from 127.0.0.1). Never set this in production.
# GANTRY_TEST_ALLOW_HTTP_GIT=1

# ---- Single sign-on (OpenID Connect, optional) -----------------------------
# Public URL of Gantry; register $GANTRY_URL/auth/oidc/callback at the provider
# GANTRY_URL=https://gantry.example.com
# OIDC_ISSUER=https://id.example.com/realms/main
# OIDC_CLIENT_ID=gantry
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=            # defaults to $GANTRY_URL/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# Create a standard user on the first SSO login of an unknown identity
# (users are linked by issuer + subject only, never by email)
# OIDC_AUTO_CREATE=false
# Members of these groups (comma-separated) are administrators; the role then
# follows the claim at every SSO login
# OIDC_ADMIN_GROUPS=gantry-admins
# OIDC_GROUPS_CLAIM=groups
# OIDC_USERNAME_CLAIM=preferred_username
# "admins": only administrators may use the password form (break-glass)
# PASSWORD_LOGIN=all

# ---- docker compose ---------------------------------------------------------
GANTRY_PORT=3000
# Group id of /var/run/docker.sock on the host: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
