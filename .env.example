# Copy to .env and adjust. Used by docker compose and by `pnpm dev`.

# ---- Database: "sqlite" (default) or "mysql" --------------------------------
DB_DRIVER=sqlite
# With MySQL under docker compose, also enable the mysql service:
# COMPOSE_PROFILES=mysql

# SQLite file (defaults to $DATA_DIR/gantry.db)
# SQLITE_PATH=./data/gantry.db

# MySQL (either DATABASE_URL or the separate fields)
# DATABASE_URL=mysql://gantry:gantry@127.0.0.1:3306/gantry
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=gantry
MYSQL_USER=gantry
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ---- Gantry -----------------------------------------------------------------
# Signs session cookies (>= 32 chars). Leave empty to auto-generate
# $DATA_DIR/secret.key. Generate one with: openssl rand -base64 48
GANTRY_SECRET=
# Where SQLite and the generated secret live (/data in the container)
# DATA_DIR=./data
# true | false | auto (Secure when the request arrived over HTTPS)
COOKIE_SECURE=auto
SESSION_TTL_HOURS=12
# true only behind a reverse proxy you control that sets X-Forwarded-For
# (enables per-client login rate limits; never trust it otherwise)
TRUST_PROXY=false
# Docker socket for the default "local" environment
# DOCKER_SOCKET=/var/run/docker.sock
# Resource usage history for the dashboard chart: how often every environment
# is sampled (seconds, minimum 10) and how long samples are kept (days)
METRICS_INTERVAL_SECONDS=60
METRICS_RETENTION_DAYS=7

# ---- docker compose ---------------------------------------------------------
GANTRY_PORT=3000
# Group id of /var/run/docker.sock on the host: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
