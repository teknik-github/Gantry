# Optional: Gantry runs without a .env. Copy to .env and uncomment what you
# need; everything else has a sensible default. Every variable, with its
# default, is listed in docs/configuration.md. Used by docker compose and by
# `pnpm dev`.

# Use the published image instead of building (then: docker compose pull)
# GANTRY_IMAGE=ghcr.io/teknik-github/gantry:latest

# Port on the host (127.0.0.1:3000 to keep it local behind a proxy)
# GANTRY_PORT=3000

# Public URL, once Gantry is behind HTTPS (SSO callbacks, agent commands)
# GANTRY_URL=https://gantry.example.com

# true only behind a reverse proxy you control that sets X-Forwarded-For
# TRUST_PROXY=false

# Skip /setup and create the first administrator at startup
# GANTRY_ADMIN_USERNAME=admin
# GANTRY_ADMIN_PASSWORD=

# MySQL instead of SQLite (docker compose starts a MySQL container too)
# COMPOSE_FILE=docker-compose.yml:docker-compose.mysql.yml
# MYSQL_PASSWORD=change-me
# MYSQL_ROOT_PASSWORD=change-me-too
